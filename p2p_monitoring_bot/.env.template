# P2P Monitoring Bot Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Browser Settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=20

# Monitoring Settings  
MONITORING_INTERVAL=60
MAX_OFFERS_PER_NOTIFICATION=3

# Auto Monitoring Settings
AUTO_MONITORING_INTERVAL=300    # 5 минут между автопроверками
AUTO_MONITORING_SAFE_INTERVAL=180  # минимум 3 минуты между уведомлениями
MAX_NOTIFICATIONS_PER_HOUR=12      # максимум уведомлений в час

# Logging
LOG_LEVEL=INFO
