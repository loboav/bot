# P2P Monitoring Bot Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Browser Settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=20

# Monitoring Settings  
MONITORING_INTERVAL=60
MAX_OFFERS_PER_NOTIFICATION=3

# Auto Monitoring Settings (БЕЗ ЛИМИТОВ - для личного использования)
AUTO_MONITORING_INTERVAL=5          # 5 секунд между проверками (МАКСИМАЛЬНАЯ СКОРОСТЬ для 1 человека!)
AUTO_MONITOR_TOP_OFFERS_LIMIT=5     # проверять только топ-5 предложений
AUTO_OPEN_BROWSER=true              # автоматически открывать ссылки в браузере при уведомлениях

# Logging
LOG_LEVEL=INFO

